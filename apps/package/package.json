{
  "name": "hookshot-live",
  "version": "0.1.3",
  "type": "module",
  "private": false,
  "main": "dist/wrapper.cjs",
  "module": "dist/wrapper.js",
  "types": "dist/wrapper.d.ts",
  "exports": {
    ".": {
      "types": "./dist/wrapper.d.ts",
      "import": "./dist/wrapper.js",
      "require": "./dist/wrapper.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "dev": "tsup --watch"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.2",
    "tsup": "^8.5.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
